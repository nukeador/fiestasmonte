<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{ meta.description or site.description }}" />
    <meta name="theme-color" content="{{ site.theme.brand }}" />
    <meta name="application-name" content="{{ site.name }}" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="{{ site.name }}" />
    <title>{{ title or site.name + ' | ' + site.location.name }}</title>
    <link rel="icon" type="image/png" href="{{ site.faviconUrl }}" />
    <link rel="manifest" href="/assets/manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="{{ site.appleTouchIconUrl }}" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} RSS" href="{{ publicBaseUrl }}/rss.xml" />
    <link rel="alternate" type="text/calendar" title="{{ site.name }} Calendario" href="{{ publicBaseUrl }}/calendar.ics" />
    {% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl }}" />{% endif %}
    {% if robotsMeta %}<meta name="robots" content="{{ robotsMeta }}" />{% endif %}
    {% if structuredData %}<script type="application/ld+json">{{ structuredData | dump | safe }}</script>{% endif %}
    {% if social %}
    <meta property="og:type" content="{{ social.type or 'website' }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ social.title or title or site.name }}" />
    <meta property="og:description" content="{{ social.description or meta.description or site.description }}" />
    {% if social.image %}
    <meta property="og:image" content="{{ social.image }}" />
    <meta property="og:image:secure_url" content="{{ social.image }}" />
    <meta property="og:image:width" content="{{ social.imageWidth or 1200 }}" />
    <meta property="og:image:height" content="{{ social.imageHeight or 630 }}" />
    <meta property="og:image:type" content="{{ social.imageType or 'image/jpeg' }}" />
    <meta property="og:image:alt" content="{{ social.imageAlt or social.title or title }}" />
    {% endif %}
    {% if social.url %}<meta property="og:url" content="{{ social.url }}" />{% endif %}
    <meta name="twitter:card" content="{{ social.card or 'summary_large_image' }}" />
    <meta name="twitter:title" content="{{ social.title or title or site.name }}" />
    <meta name="twitter:description" content="{{ social.description or meta.description or site.description }}" />
    {% if social.image %}
    <meta name="twitter:image" content="{{ social.image }}" />
    <meta name="twitter:image:alt" content="{{ social.imageAlt or social.title or title }}" />
    {% endif %}
    {% endif %}
    {% block extraHead %}{% endblock %}
    <script>
      window.__FIESTAS_ANALYTICS_CONFIG__ = {{ analyticsConfig | dump | safe }};
      window.__FIESTAS_SITE__ = {{ site | dump | safe }};
    </script>
    <script>
      (function () {
        const key = 'fiestasMonte:theme';
        try {
          const saved = window.localStorage.getItem(key);
          const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = saved === 'dark' || saved === 'light' ? saved : (prefersDark ? 'dark' : 'light');
          if (theme === 'dark') document.documentElement.classList.add('dark');
          document.documentElement.style.colorScheme = theme;
        } catch (_) {}
      }());
    </script>
    <link rel="stylesheet" href="/assets/css/{{ pageCss }}" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  </head>
  <body class="{% block bodyClass %}{% endblock %}">
    {% block header %}{% endblock %}
    {% block body %}{% endblock %}
    <footer class="site-footer{% block footerClass %}{% endblock %}">
      <div class="site-footer-inner">
        <p class="site-footer-copy">
          <a href="{{ site.municipalityUrl }}" target="_blank" rel="noopener noreferrer">montemayordepililla.com</a> es una web independiente del Ayuntamiento, creada por vecinos en 2002.
          · <a href="{{ site.officialSourceUrl }}" target="_blank" rel="noopener noreferrer">Programa oficial</a>
          · Código en <a href="https://github.com/nukeador/fiestasmonte" target="_blank" rel="noopener noreferrer">GitHub</a>
        </p>
      </div>
    </footer>
    <button
      class="scroll-top-btn is-hidden"
      type="button"
      data-scroll-top
      aria-label="Volver arriba"
      title="Volver arriba"
      aria-hidden="true"
      tabindex="-1"
    >
      <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>
    <script type="module" src="/assets/js/{{ pageJs }}?v={{ jsVersion }}" defer></script>
    {% block extraScripts %}{% endblock %}
    <script type="module" src="/assets/js/scroll-top.{{ jsVersion }}.js" defer></script>
    <script type="module" src="/assets/js/pwa.{{ jsVersion }}.js" defer></script>
  </body>
</html>
